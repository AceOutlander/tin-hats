{
  "name": "tin-hats",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "description": "Tin Hats - a 2D side-view WW2 real-time strategy game for mobile browsers",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:balance": "vitest run tests/balance",
    "test:e2e": "playwright test",
    "test:perf": "playwright test -c playwright.perf.config.ts",
    "sim": "tsx tools/sim-cli.ts",
    "icons": "tsx tools/gen-icons.ts",
    "perf": "tsx tools/perf.ts",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test:unit"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "1.3",
    "vitest": "^5.0.3"
  }
}
